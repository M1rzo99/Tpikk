{
  "name": "topik-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/content/seed.ts",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@grammyjs/runner": "^2.0.3",
    "@prisma/client": "^6.19.3",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^18.0.4",
    "ffmpeg-static": "^5.3.0",
    "grammy": "^1.46.0",
    "msedge-tts": "^2.0.8",
    "node-cron": "^4.6.0",
    "pretendard": "^1.3.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
